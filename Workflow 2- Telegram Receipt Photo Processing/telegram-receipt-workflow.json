      "id": "if-has-photo-id",
      "name": "If: Has Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Please send a photo of your receipt. ",
        "additionalFields": {}
      },
      "id": "telegram-ask-photo-id",
      "name": "Telegram: Ask for Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        200,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-api-credential-id",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pick the highest-resolution photo (last element of the array)\nconst message = $('If: Has Photo?').item.json.message;\nconst photoArr = Array.isArray(message.photo) ? message.photo : [];\nconst bestPhoto = photoArr.length > 0 ? photoArr[photoArr.length - 1] : null;\n\nif (!bestPhoto) {\n  throw new Error('No photo found in message despite the If check passing.');\n}\n\nreturn [\n  {\n    json: {\n      chatId: message.chat.id,\n      messageId: message.message_id,\n      bestFileId: bestPhoto.file_id,\n      caption: message.caption || '',\n      fromUser: message.from || {},\n      messageTimestamp: message.date\n    }\n  }\n];\n"
      },
      "id": "pick-best-photo-id",
      "name": "Pick Best Photo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.bestFileId }}",
        "additionalFields": {}
      },
      "id": "telegram-get-file-id",
      "name": "Telegram: Get File Info",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-api-credential-id",
          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/file/bot{{ $credentials.telegramApi.accessToken }}/{{ $json.result.file_path }}",
        "responseFormat": "file",
        "options": {}
      },
      "id": "http-download-file-id",
      "name": "HTTP: Download Photo Bytes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a clean filename and assemble the receipt payload, preserving the photo binary\nconst meta = $('Pick Best Photo').item.json;\nconst fileInfo = $('Telegram: Get File Info').first().json.result || {};\nconst filePath = fileInfo.file_path || '';\nconst fileExt = (filePath.split('.').pop() || 'jpg').toLowerCase();\n\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;\nconst cleanFileName = `receipt_${meta.fromUser.id || 'anon'}_${stamp}.${fileExt}`;\n\nconst submissionDate = new Date(meta.messageTimestamp * 1000).toISOString();\n\nreturn [\n  {\n    json: {\n      chatId: meta.chatId,\n      messageId: meta.messageId,\n      telegramUserId: meta.fromUser.id || null,\n      telegramUsername: meta.fromUser.username || '',\n      telegramFirstName: meta.fromUser.first_name || '',\n      caption: meta.caption || '',\n      originalFileName: cleanFileName,\n      photoFileId: meta.bestFileId,\n      photoFileSize: fileInfo.file_size || 0,\n      submissionDate,\n      submissionDateFolder: submissionDate.slice(0, 10)\n    },\n    binary: $('HTTP: Download Photo Bytes').item.binary\n  }\n];\n"
      },
      "id": "build-payload-id",
      "name": "Build Receipt Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "YOUR_GEMINI_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are a precise receipt OCR assistant. Extract structured data from this receipt image and return ONLY a valid JSON object with these exact fields (use null for missing values, never guess):\\n\\n{\\n  \\\"merchant_name\\\": string,\\n  \\\"merchant_address\\\": string | null,\\n  \\\"receipt_date\\\": string (ISO 8601 YYYY-MM-DD or null),\\n  \\\"receipt_time\\\": string (HH:MM 24h or null),\\n  \\\"currency\\\": string (ISO 4217 like USD, EUR, GBP, PHP or null),\\n  \\\"subtotal\\\": number | null,\\n  \\\"tax\\\": number | null,\\n  \\\"tip\\\": number | null,\\n  \\\"total_amount\\\": number,\\n  \\\"payment_method\\\": string (cash, card, mobile, etc. or null),\\n  \\\"card_last4\\\": string | null,\\n  \\\"category\\\": string (one of: meals, travel, office, software, hardware, entertainment, utilities, other or null),\\n  \\\"line_items\\\": [{ \\\"description\\\": string, \\\"quantity\\\": number, \\\"unit_price\\\": number, \\\"total\\\": number }],\\n  \\\"notes\\\": string | null\\n}\\n\\nRules:\\n- If you cannot read a value clearly, set it to null.\\n- total_amount is the GRAND TOTAL including tax and tip.\\n- Return ONLY the JSON object. No markdown fences, no commentary, no prose.\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"{{ $binary.data.mimeType }}\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"topP\": 0.8,\n    \"maxOutputTokens\": 2048,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "http-gemini-extract-id",
      "name": "HTTP: Gemini Vision Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse Gemini's JSON response and normalize it for the spreadsheet\nconst geminiResponse = $input.first().json;\nconst text = geminiResponse?.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n\nlet parsed = {};\nlet parseError = false;\nlet parseErrorMessage = '';\ntry {\n  const cleaned = text\n    .trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```\\s*$/i, '')\n    .trim();\n  parsed = JSON.parse(cleaned);\n} catch (err) {\n  parseError = true;\n  parseErrorMessage = err.message;\n}\n\nconst toNumber = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return v;\n  const n = parseFloat(String(v).replace(/[^0-9.\\-]/g, ''));\n  return Number.isFinite(n) ? n : null;\n};\n\nconst meta = $('Build Receipt Payload').item.json;\n\nreturn [\n  {\n    json: {\n      ...meta,\n      parseError,\n      parseErrorMessage,\n      merchantName: parsed.merchant_name || null,\n      merchantAddress: parsed.merchant_address || null,\n      receiptDate: parsed.receipt_date || null,\n      receiptTime: parsed.receipt_time || null,\n      currency: parsed.currency || null,\n      subtotal: toNumber(parsed.subtotal),\n      tax: toNumber(parsed.tax),\n      tip: toNumber(parsed.tip),\n      totalAmount: toNumber(parsed.total_amount),\n      paymentMethod: parsed.payment_method || null,\n      cardLast4: parsed.card_last4 || null,\n      category: parsed.category || null,\n      lineItemCount: Array.isArray(parsed.line_items) ? parsed.line_items.length : 0,\n      lineItemsJson: JSON.stringify(parsed.line_items || []),\n      notes: parsed.notes || null,\n      ocrModel: 'gemini-2.5-flash',\n      ocrTimestamp: new Date().toISOString()\n    },\n    binary: $('Build Receipt Payload').item.binary\n  }\n];\n"
      },
