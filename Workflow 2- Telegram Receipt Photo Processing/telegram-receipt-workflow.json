    {
      "parameters": {
        "jsCode": "// Resolve the date folder ID whether it was just created or already existed, and pass through the photo binary\nconst incoming = $input.first().json;\nconst newlyCreated = $('HTTP: Create Date Folder').first()?.json;\nconst existing = $('HTTP: Find Date Folder').first()?.json?.files?.[0];\nconst dateFolderId = (newlyCreated && newlyCreated.id) || (existing && existing.id) || null;\nif (!dateFolderId) throw new Error('Could not resolve a date folder ID.');\nreturn [\n  {\n    json: { ...incoming, dateFolderId },\n    binary: $('Parse & Normalize Gemini Output').item.binary\n  }\n];\n"
      },
