    {
      "parameters": {
        "jsCode": "// Sanitize the date folder name and escape apostrophes for the Drive query\nconst data = $input.first().json;\nconst escapeDriveString = (s) => String(s).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\nconst safeFolder = (data.submissionDateFolder || new Date().toISOString().slice(0, 10))\n  .replace(/[<>:\"/\\\\|?*]/g, '_')\n  .trim();\nreturn [\n  {\n    json: {\n      ...data,\n      dateFolder: safeFolder,\n      dateFolderEscaped: escapeDriveString(safeFolder)\n    }\n  }\n];\n"
      },
