      "parameters": {
        "jsCode": "// Build folder names and escape apostrophes for the Drive query\n// Folder structure: /<root>/<labelFolderName>/<senderFolderName>/<dateFolder>/<attachment>\nconst data = $input.first().json;\n\nconst escapeDriveString = (s) => String(s).replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\n\nconst sanitizeFolderName = (name, fallback) => String(name || fallback)\n  .replace(/[<>:\"/\\\\|?*]/g, '_')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 100);\n\nconst safeLabelFolderName = sanitizeFolderName(data.searchLabel, 'Unlabeled');\nconst safeSenderFolderName = sanitizeFolderName(data.senderName, 'Unknown Sender');\n\nconst receivedDate = new Date(data.dateReceived);\nconst formattedDate = isNaN(receivedDate.getTime())\n  ? new Date().toISOString().slice(0, 10)\n  : receivedDate.toISOString().slice(0, 10);\n\nreturn [\n  {\n    json: {\n      ...data,\n      labelFolderName: safeLabelFolderName,\n      senderFolderName: safeSenderFolderName,\n      dateFolder: formattedDate,\n      rootFolderId: 'YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID_HERE',\n      labelFolderNameEscaped: escapeDriveString(safeLabelFolderName),\n      senderFolderNameEscaped: escapeDriveString(safeSenderFolderName),\n      dateFolderEscaped: escapeDriveString(formattedDate)\n    }\n  }\n];"
      },
      "id": "prepare-folders-id",
      "name": "Prepare Sender & Date Folder Names",
      "type": "n8n-nodes-base.code",
