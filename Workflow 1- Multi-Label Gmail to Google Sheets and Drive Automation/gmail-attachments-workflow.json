    {
      "parameters": {
        "jsCode": "// Extract clean data from the Gmail payload and prepare a row for Google Sheets\nconst email = $input.first().json;\n\nconst header = (name) => {\n  const headers = email.headers || [];\n  const found = headers.find(h => h.name && h.name.toLowerCase() === name.toLowerCase());\n  return found ? found.value : '';\n};\n\nconst fromHeader = header('From');\nconst subject = email.subject || '';\nconst dateReceived = email.date || email.internalDate || new Date().toISOString();\nconst snippet = email.snippet || '';\nconst messageId = email.id || '';\nconst threadId = email.threadId || '';\n\nlet senderName = fromHeader;\nlet senderEmail = '';\nconst match = fromHeader.match(/^(.*?)\\s*<([^>]+)>$/);\nif (match) {\n  senderName = match[1].replace(/\"/g, '').trim();\n  senderEmail = match[2].trim();\n} else if (fromHeader.includes('@')) {\n  senderEmail = fromHeader.trim();\n  senderName = fromHeader.trim();\n}\n\nconst labels = (email.labelIds || []).filter(l => !/^(INBOX|CATEGORY_|UNREAD|STARRED|IMPORTANT|SENT|TRASH|DRAFT|SPAM)$/i.test(l));\n\n// Walk the parts tree to find every attachment\nconst collectAttachments = (parts) => {\n  if (!parts) return [];\n  const out = [];\n  for (const p of parts) {\n    if (p.filename && p.body && p.body.attachmentId) {\n      out.push({\n        attachmentId: p.body.attachmentId,\n        filename: p.filename,\n        mimeType: p.mimeType || 'application/octet-stream',\n        size: p.body.size || 0\n      });\n    }\n    if (p.parts) out.push(...collectAttachments(p.parts));\n  }\n  return out;\n};\nconst attachments = collectAttachments(email.payload && email.payload.parts);\n\nreturn [\n  {\n    json: {\n      messageId,\n      threadId,\n      senderName,\n      senderEmail,\n      subject,\n      dateReceived,\n      snippet,\n      labels,\n      attachments,\n      hasAttachments: attachments.length > 0,\n      searchLabel: $('Build Dynamic Gmail Search Query').item.json.labelName\n    }\n  }\n];\n"
      },
