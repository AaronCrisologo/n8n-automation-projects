      "parameters": {
        "jsCode": "// Pull the sender folder ID into the workflow data whether it was just created or already existed\nconst incoming = $input.first().json;\nconst newlyCreated = $('HTTP: Create Sender Folder').first()?.json;\nconst existing = $('HTTP: Find Existing Sender Folder').first()?.json?.files?.[0];\nconst senderFolderId = (newlyCreated && newlyCreated.id) || (existing && existing.id) || null;\nif (!senderFolderId) throw new Error('Could not resolve a sender folder ID.');\nreturn [\n  {\n    json: { ...incoming, senderFolderId }\n  }\n];\n"
