      "parameters": {
        "jsCode": "// Build the Gmail search query for the current label\nconst label = $input.first().json.label_1\n  || $input.first().json.label_2\n  || $input.first().json.label_3\n  || $input.first().json.label_4\n  || $input.first().json.label_5;\n\nconst cleanLabel = String(label).replace(/^label:/, '').trim();\n\nreturn [\n  {\n    json: {\n      searchQuery: `label:${cleanLabel} is:unread newer_than:1d`,\n      labelName: cleanLabel\n    }\n  }\n];\n"
      },
      "id": "build-query-id",
      "name": "Build Dynamic Gmail Search Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
